{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information synchronized upon login",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth user ID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server last update timestamp"
        }
      },
      "required": ["id", "email", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Saved conversation sessions belonging to a specific user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Session UUID identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "title": {
          "type": "string",
          "description": "Meaningful conversation title (max 200 chars)",
          "maxLength": 200
        },
        "mode": {
          "type": "string",
          "description": "AI assistant mode",
          "enum": ["general", "citizen", "coding", "writing", "research", "learning"]
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last updated timestamp in milliseconds"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the conversation is pinned to the top of the sidebar"
        },
        "pinnedAt": {
          "type": "number",
          "description": "Timestamp in milliseconds when session was pinned"
        }
      },
      "required": ["id", "userId", "title", "mode", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a user chat session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message identifier"
        },
        "sessionId": {
          "type": "string",
          "description": "Parent session identifier"
        },
        "userId": {
          "type": "string",
          "description": "Author user ID"
        },
        "role": {
          "type": "string",
          "description": "Message author role",
          "enum": ["user", "assistant", "system"]
        },
        "content": {
          "type": "string",
          "description": "Message text markdown content",
          "maxLength": 50000
        },
        "timestamp": {
          "type": "number",
          "description": "Unix timestamp in milliseconds"
        },
        "citations": {
          "type": "array",
          "description": "Web citation titles from Google Search grounding"
        }
      },
      "required": ["id", "sessionId", "userId", "role", "content", "timestamp"]
    },
    "CommunityUser": {
      "title": "CommunityUser",
      "description": "Public directory of registered platform users with online presence",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user identifier"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "description": "Public email or username handle"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Real-time presence status"
        },
        "lastActive": {
          "type": "number",
          "description": "Timestamp in milliseconds of last platform activity"
        },
        "role": {
          "type": "string",
          "description": "User role or bio title"
        },
        "bio": {
          "type": "string",
          "description": "User short bio or status message"
        }
      },
      "required": ["id", "displayName", "isOnline", "lastActive"]
    },
    "CommunityMessage": {
      "title": "CommunityMessage",
      "description": "Direct and community messages exchanged between users",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message UUID"
        },
        "conversationId": {
          "type": "string",
          "description": "Identifier for conversation thread"
        },
        "senderId": {
          "type": "string",
          "description": "Sender user ID"
        },
        "senderName": {
          "type": "string",
          "description": "Sender display name"
        },
        "senderPhoto": {
          "type": "string",
          "description": "Sender avatar URL"
        },
        "receiverId": {
          "type": "string",
          "description": "Target receiver ID or 'community_public'"
        },
        "text": {
          "type": "string",
          "description": "Message text content",
          "maxLength": 10000
        },
        "type": {
          "type": "string",
          "enum": ["text", "audio", "call_log", "image"]
        },
        "timestamp": {
          "type": "number",
          "description": "Message creation timestamp in milliseconds"
        },
        "read": {
          "type": "boolean",
          "description": "Whether the message has been read by the receiver"
        }
      },
      "required": ["id", "conversationId", "senderId", "senderName", "receiverId", "text", "timestamp"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "Audio and video call signaling sessions between users",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Call session identifier"
        },
        "callerId": {
          "type": "string",
          "description": "Caller user ID"
        },
        "callerName": {
          "type": "string",
          "description": "Caller display name"
        },
        "callerPhoto": {
          "type": "string",
          "description": "Caller avatar URL"
        },
        "receiverId": {
          "type": "string",
          "description": "Receiver user ID"
        },
        "receiverName": {
          "type": "string",
          "description": "Receiver display name"
        },
        "type": {
          "type": "string",
          "enum": ["audio", "video"]
        },
        "status": {
          "type": "string",
          "enum": ["calling", "ringing", "connected", "ended", "declined", "missed"]
        },
        "createdAt": {
          "type": "number",
          "description": "Call initiation timestamp"
        },
        "endedAt": {
          "type": "number",
          "description": "Call termination timestamp"
        },
        "duration": {
          "type": "number",
          "description": "Call duration in seconds"
        }
      },
      "required": ["id", "callerId", "callerName", "receiverId", "type", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document accessible only to the owner"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "User private chat sessions collection"
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages inside a user private chat session"
    },
    "/community_users/{userId}": {
      "schema": "CommunityUser",
      "description": "Public community member directory showing who is using the platform and live online/offline presence"
    },
    "/community_messages/{messageId}": {
      "schema": "CommunityMessage",
      "description": "Messages sent between users in direct chats or the community group"
    },
    "/calls/{callId}": {
      "schema": "CallSession",
      "description": "Audio and video call sessions and WebRTC signaling between users"
    }
  }
}
